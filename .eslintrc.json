{
  "root": true,
  "extends": "next/core-web-vitals",
  "ignorePatterns": [
    "test-*.js",
    "proxy.js",
    "scripts/"
  ],
  "rules": {
    "no-unused-vars": ["warn", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["error"] }],
    "react/no-unescaped-entities": "off"
  },
  "overrides": [
    {
      "files": ["components/pitch/tokens.js", "components/pitch/slides.jsx"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["app/admin/hearst/**/*.{js,jsx,ts,tsx}", "components/hearst/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "no-restricted-syntax": ["error",
          {
            "selector": "Literal[value=/var\\(--color-/]",
            "message": "Hearst module is isolated from the site DS. Use a --cp-* token from cockpit.css instead of --color-*."
          },
          {
            "selector": "TemplateElement[value.raw=/var\\(--color-/]",
            "message": "Hearst module is isolated from the site DS. Use a --cp-* token from cockpit.css instead of --color-*."
          },
          {
            "selector": "Literal[value=/#[0-9A-Fa-f]{6}\\b/]",
            "message": "Hearst module forbids hardcoded hex colors. Use a --cp-* token from cockpit.css. (Pure #fff/#000 still allowed as 3-digit shorthand if truly needed.)"
          },
          {
            "selector": "TemplateElement[value.raw=/#[0-9A-Fa-f]{6}\\b/]",
            "message": "Hearst module forbids hardcoded hex colors. Use a --cp-* token from cockpit.css."
          }
        ]
      }
    }
  ]
}

# Google Maps Platform API key — required for /rdc-3d page
# Streams Google Photorealistic 3D Tiles of the QF Research Complex.
#
# How to get it (5 min, free):
#   1. https://console.cloud.google.com/google/maps-apis/
#   2. Create a project (or pick an existing one)
#   3. Enable "Map Tiles API" in the API library
#   4. Credentials → Create credentials → API key
#   5. Copy the key, then create .env.local with:
#
#      NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_KEY_HERE
#
#   6. Restart `npm run dev`
#
# Free quota: 25 000 tile loads/day. Plenty for a pitch demo.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

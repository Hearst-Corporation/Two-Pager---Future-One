# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — required for strategic memo generation
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MEMO_MODEL=gpt-4.1

# Optional — Google Maps Photorealistic 3D Tiles for /rdc-3d
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — site base URL used for auth callbacks. Defaults to http://localhost:5005 locally.
NEXT_PUBLIC_SITE_URL=

# DEV ONLY — bypasses Supabase auth on /admin/*. NEVER set in production environments.
# ADMIN_DEV_AUTOLOGIN_EMAIL=

# Optional — Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

LOG_LEVEL=

# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (Hyperbolic — OpenAI-compatible) — required for /api/admin/hearst/advisor
# Get a key at https://app.hyperbolic.xyz/ or your hypercli console.
HYPERBOLIC_API_KEY=

# Moonshot AI (Kimi K2.6) — required for /api/cockpit-chat (Cockpit right-rail chat) via Moonshot AI.
# Key catalog: ~/.claude/api-config/SERVICES.md — NEVER hardcode in source.
MOONSHOT_API_KEY=sk-your-moonshot-key-here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# DEPRECATED — Hypercli replaced by Moonshot AI (kept for reference only, no longer used)
# HYPERCLI_API_KEY=
# HYPERCLI_BASE_URL=https://api.hypercli.com/v1
# HYPERCLI_DEFAULT_MODEL=kimi-k2.6

# Optional — Google Maps Photorealistic 3D Tiles for /rdc-3d
# Free 25k tile loads/day. Create at https://console.cloud.google.com/google/maps-apis/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — site base URL used for auth callbacks. Defaults to http://localhost:5005 locally.
NEXT_PUBLIC_SITE_URL=

# DEV ONLY — bypasses Supabase auth on /admin/*. NEVER set in production environments.
# When set, middleware.js skips Supabase auth and supabase-server.js loads the profile by this email.
# ADMIN_DEV_AUTOLOGIN_EMAIL=

# Optional — Sentry error tracking. Server-side DSN + client-side DSN can be the same.
# Leave empty to skip Sentry init (all 3 configs are DSN-gated no-ops).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional — Source map upload during build (skip in local dev).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional — structured logger threshold. One of: debug | info | warn | error.
# Default: info.
LOG_LEVEL=

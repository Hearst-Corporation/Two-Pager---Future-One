# =============================================================================
# ⚠️  SECURITY WARNING
# This file is an EXAMPLE. Copy to .env.local and fill with real values.
# NEVER commit .env.local to git.
# =============================================================================

# Google Maps — frontend key (restricted to your domain in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase — project URL and anon key (public, safe for frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (SERVER-SIDE ONLY, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used by /api/admin/hearst/advisor (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=

# Hypercli (Kimi 2.6) — used by /api/cockpit-chat (Cockpit right-rail chat).
# Key catalog: ~/.claude/api-config/SERVICES.md — NEVER hardcode in source.
HYPERCLI_API_KEY=
HYPERCLI_BASE_URL=https://api.hypercli.com/v1
HYPERCLI_DEFAULT_MODEL=kimi-k2.6

# Legacy: Hyperbolic / OpenAI-compatible endpoint (no longer used)
# HYPERBOLIC_API_KEY=

# Sentry — error monitoring (optional but recommended for production)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Dev-only autologin: when NODE_ENV=development AND this email is set,
# /admin bypasses Supabase Auth and uses the matching crm.profiles row.
# Strict no-op in production. Leave commented to disable.
# ADMIN_DEV_AUTOLOGIN_EMAIL=

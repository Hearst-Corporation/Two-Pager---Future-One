# =============================================================================
# ⚠️  SECURITY WARNING
# This file is an EXAMPLE. Copy to .env.local and fill with real values.
# NEVER commit .env.local to git.
# =============================================================================

# Google Maps — frontend key (restricted to your domain in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase — project URL and anon key (public, safe for frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (SERVER-SIDE ONLY, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — required for /api/cockpit-chat and /api/admin/hearst/strategic-memo
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MEMO_MODEL=gpt-4.1

# Sentry — error monitoring (optional but recommended for production)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Dev-only autologin: when NODE_ENV=development AND this email is set,
# /admin bypasses Supabase Auth and uses the matching crm.profiles row.
# Strict no-op in production. Leave commented to disable.
# ADMIN_DEV_AUTOLOGIN_EMAIL=

# SAFE_DEMO_MODE (Wave 1) — set both to 1 for a zero-surprise presentation.
# Disables the advisor, cockpit chat, agent chat, live refresh and gpu-prices
# endpoints (they return 503) and shows a "Demo Mode" badge in the cockpit.
# SAFE_DEMO_MODE is read server-side; NEXT_PUBLIC_ mirror drives the UI badge.
# SAFE_DEMO_MODE=1
# NEXT_PUBLIC_SAFE_DEMO_MODE=1

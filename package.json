{
  "name": "prese-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5005",
    "dev:clean": "sh -c 'pids=$(lsof -nP -iTCP:5005 -sTCP:LISTEN -t 2>/dev/null); [ -n \"$pids\" ] && kill -9 $pids; rm -rf .next && npm run dev'",
    "rundev": "npm run dev",
    "build": "next build",
    "start": "next start -p 5005",
    "export": "node scripts/export.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "SKIP_ENV_VALIDATION=true next lint",
    "lint:secrets": "node scripts/lint-secrets.mjs",
    "prune:tokens": "node scripts/prune-tokens.mjs",
    "new:feature": "node scripts/new-feature.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke:openai": "node scripts/smoke-openai.mjs",
    "check": "npm run lint:secrets && npm run lint && npm test",
    "check:ci": "npm run check && next build",
    "check:deploy-env": "node scripts/check-deploy-env.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^8",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "dompurify": "^3.2.0",
    "lucide-react": "0.456.0",
    "next": "^14.2.35",
    "openai": "^6.38.0",
    "prop-types": "^15.8.1",
    "puppeteer-core": "^25.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "puppeteer": "^24.42.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  },
  "browserslist": [
    "last 2 years"
  ],
  "overrides": {
    "postcss": "^8.5.10",
    "glob": "^10.4.6",
    "uuid": "^11.1.1"
  }
}
